{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://monika.local/schemas/command-result.schema.json",
  "title": "CommandResult",
  "type": "object",
  "required": [
    "schemaVersion",
    "command",
    "status",
    "diagnostics",
    "patches",
    "changedArtifacts",
    "conflicts",
    "snapshots",
    "artifacts",
    "regions",
    "references",
    "annotations",
    "capabilities",
    "exitClass"
  ],
  "properties": {
    "schemaVersion": {
      "const": "5"
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "ok",
        "diagnostics-found",
        "patches-proposed",
        "applied",
        "conflict",
        "invalid-input",
        "internal-error"
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "patches": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/patch"
      }
    },
    "changedArtifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/changedArtifact"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/conflict"
      }
    },
    "snapshots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/snapshot"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "regions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/region"
      }
    },
    "references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference"
      }
    },
    "annotations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/annotation"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          {
            "type": "string"
          },
          {
            "type": "boolean"
          }
        ]
      }
    },
    "exitClass": {
      "enum": [
        "success",
        "diagnostic-error",
        "usage-error",
        "internal-error"
      ]
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "oneOf": [
        {
          "required": [
            "status",
            "diagnostics",
            "patches",
            "changedArtifacts",
            "conflicts"
          ],
          "properties": {
            "status": {
              "const": "ok"
            },
            "diagnostics": {
              "maxItems": 0
            },
            "patches": {
              "maxItems": 0
            },
            "changedArtifacts": {
              "maxItems": 0
            },
            "conflicts": {
              "maxItems": 0
            }
          }
        },
        {
          "required": [
            "status",
            "diagnostics",
            "patches",
            "changedArtifacts",
            "conflicts"
          ],
          "properties": {
            "status": {
              "const": "diagnostics-found"
            },
            "diagnostics": {
              "minItems": 1
            },
            "patches": {
              "maxItems": 0
            },
            "changedArtifacts": {
              "maxItems": 0
            },
            "conflicts": {
              "maxItems": 0
            }
          }
        },
        {
          "required": [
            "status",
            "patches",
            "changedArtifacts",
            "conflicts"
          ],
          "properties": {
            "status": {
              "const": "patches-proposed"
            },
            "patches": {
              "minItems": 1
            },
            "changedArtifacts": {
              "maxItems": 0
            },
            "conflicts": {
              "maxItems": 0
            }
          }
        },
        {
          "required": [
            "status",
            "patches",
            "changedArtifacts",
            "conflicts"
          ],
          "properties": {
            "status": {
              "const": "applied"
            },
            "patches": {
              "maxItems": 0
            },
            "changedArtifacts": {
              "minItems": 1
            },
            "conflicts": {
              "maxItems": 0
            }
          }
        },
        {
          "required": [
            "status",
            "patches",
            "changedArtifacts",
            "conflicts"
          ],
          "properties": {
            "status": {
              "const": "conflict"
            },
            "patches": {
              "maxItems": 0
            },
            "changedArtifacts": {
              "maxItems": 0
            },
            "conflicts": {
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "status",
            "patches",
            "changedArtifacts",
            "conflicts"
          ],
          "properties": {
            "status": {
              "const": "invalid-input"
            },
            "patches": {
              "maxItems": 0
            },
            "changedArtifacts": {
              "maxItems": 0
            },
            "conflicts": {
              "maxItems": 0
            }
          }
        },
        {
          "required": [
            "status",
            "patches",
            "changedArtifacts",
            "conflicts"
          ],
          "properties": {
            "status": {
              "const": "internal-error"
            },
            "patches": {
              "maxItems": 0
            },
            "changedArtifacts": {
              "maxItems": 0
            },
            "conflicts": {
              "maxItems": 0
            }
          }
        }
      ]
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "invalid-input"
          }
        }
      },
      "then": {
        "properties": {
          "exitClass": {
            "const": "usage-error"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "internal-error"
          }
        }
      },
      "then": {
        "properties": {
          "exitClass": {
            "const": "internal-error"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "conflict"
          }
        }
      },
      "then": {
        "properties": {
          "exitClass": {
            "const": "diagnostic-error"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "ok",
              "diagnostics-found",
              "patches-proposed",
              "applied"
            ]
          },
          "diagnostics": {
            "contains": {
              "type": "object",
              "required": [
                "effectiveSeverity"
              ],
              "properties": {
                "effectiveSeverity": {
                  "const": "error"
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "exitClass": {
            "const": "diagnostic-error"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "ok",
              "diagnostics-found",
              "patches-proposed",
              "applied"
            ]
          },
          "diagnostics": {
            "not": {
              "contains": {
                "type": "object",
                "required": [
                  "effectiveSeverity"
                ],
                "properties": {
                  "effectiveSeverity": {
                    "const": "error"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "exitClass": {
            "const": "success"
          }
        }
      }
    }
  ],
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!(?:\\.{1,2})(?:/|$))(?:[A-Za-z0-9._~-]|%(?:0[1-9A-F]|1[0-9A-F]|2[0-9A-C]|3[A-F]|40|5[B-E]|60|7[B-D]|7F|[89A-F][0-9A-F]))+(?:/(?!(?:\\.{1,2})(?:/|$))(?:[A-Za-z0-9._~-]|%(?:0[1-9A-F]|1[0-9A-F]|2[0-9A-C]|3[A-F]|40|5[B-E]|60|7[B-D]|7F|[89A-F][0-9A-F]))+)*(?![\\s\\S])"
    },
    "contentIdentity": {
      "type": "object",
      "required": [
        "hash",
        "size"
      ],
      "properties": {
        "hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "range": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "end": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "detail": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "edit": {
      "type": "object",
      "required": [
        "range",
        "replacement"
      ],
      "properties": {
        "range": {
          "$ref": "#/$defs/range"
        },
        "replacement": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "patch": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "id",
            "operation",
            "target",
            "resultingContentIdentity",
            "content",
            "reason",
            "provenance"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "operation": {
              "const": "create"
            },
            "target": {
              "$ref": "#/$defs/path"
            },
            "resultingContentIdentity": {
              "$ref": "#/$defs/contentIdentity"
            },
            "content": {
              "type": "string"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "provenance": {
              "$ref": "#/$defs/provenance"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "id",
            "operation",
            "target",
            "expectedContentIdentity",
            "resultingContentIdentity",
            "edits",
            "reason",
            "provenance"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "operation": {
              "const": "edit"
            },
            "target": {
              "$ref": "#/$defs/path"
            },
            "expectedContentIdentity": {
              "$ref": "#/$defs/contentIdentity"
            },
            "resultingContentIdentity": {
              "$ref": "#/$defs/contentIdentity"
            },
            "edits": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/edit"
              }
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "provenance": {
              "$ref": "#/$defs/provenance"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "scopedId": {
      "type": "object",
      "required": [
        "artifact",
        "local"
      ],
      "properties": {
        "artifact": {
          "type": "string",
          "minLength": 1
        },
        "local": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "location": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "artifact": {
          "type": "string",
          "minLength": 1
        },
        "region": {
          "$ref": "#/$defs/scopedId"
        },
        "annotation": {
          "$ref": "#/$defs/scopedId"
        },
        "range": {
          "$ref": "#/$defs/range"
        }
      },
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "required": [
        "code",
        "defaultSeverity",
        "effectiveSeverity",
        "message",
        "suggestedFixes"
      ],
      "properties": {
        "code": {
          "enum": [
            "sidecar-only",
            "inline-only",
            "divergent",
            "stale-selector",
            "duplicate",
            "unreferenced-ref",
            "unresolved-ref",
            "expectation-failed",
            "invalid-sidecar",
            "invalid-selector",
            "authored-override",
            "unsupported-artifact",
            "unsupported-filesystem-entry"
          ]
        },
        "defaultSeverity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "effectiveSeverity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "suggestedFixes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/patch"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "code": {
                "enum": [
                  "sidecar-only",
                  "authored-override"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "defaultSeverity": {
                "const": "info"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "enum": [
                  "inline-only",
                  "duplicate",
                  "unreferenced-ref",
                  "unsupported-artifact",
                  "unsupported-filesystem-entry"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "defaultSeverity": {
                "const": "warning"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "enum": [
                  "divergent",
                  "stale-selector",
                  "unresolved-ref",
                  "expectation-failed",
                  "invalid-sidecar",
                  "invalid-selector"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "defaultSeverity": {
                "const": "error"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "origin": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "path"
          ],
          "properties": {
            "kind": {
              "const": "workspace"
            },
            "path": {
              "$ref": "#/$defs/path"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "repo",
            "path"
          ],
          "properties": {
            "kind": {
              "const": "git"
            },
            "repo": {
              "type": "string",
              "minLength": 1
            },
            "rev": {
              "type": "string",
              "minLength": 1
            },
            "path": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "url"
          ],
          "properties": {
            "kind": {
              "const": "web"
            },
            "url": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "name"
          ],
          "properties": {
            "kind": {
              "const": "generated"
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "uri"
          ],
          "properties": {
            "kind": {
              "const": "external"
            },
            "uri": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "selector": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "whole-artifact"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "const": "region-id"
            },
            "id": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "range"
          ],
          "properties": {
            "kind": {
              "const": "text-range"
            },
            "range": {
              "$ref": "#/$defs/range"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "where"
          ],
          "properties": {
            "kind": {
              "const": "row-filter"
            },
            "where": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {
                "minLength": 1
              },
              "additionalProperties": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "boolean"
                  }
                ]
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "artifact": {
      "type": "object",
      "required": [
        "id",
        "origin",
        "contentIdentity"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "$ref": "#/$defs/origin"
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        },
        "contentIdentity": {
          "$ref": "#/$defs/contentIdentity"
        }
      },
      "additionalProperties": false
    },
    "regionAddress": {
      "type": "object",
      "required": [
        "artifact",
        "selector"
      ],
      "properties": {
        "artifact": {
          "$ref": "#/$defs/origin"
        },
        "selector": {
          "$ref": "#/$defs/selector"
        },
        "interpreter": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "regionRef": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "const": "resolved"
            },
            "id": {
              "$ref": "#/$defs/scopedId"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "address"
          ],
          "properties": {
            "kind": {
              "const": "address"
            },
            "address": {
              "$ref": "#/$defs/regionAddress"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "region": {
      "type": "object",
      "required": [
        "id",
        "selector",
        "interpreter"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/scopedId"
        },
        "selector": {
          "$ref": "#/$defs/selector"
        },
        "interpreter": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string"
        },
        "range": {
          "$ref": "#/$defs/range"
        },
        "fingerprint": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "expectation": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "digest"
          ],
          "properties": {
            "kind": {
              "const": "digest"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "reference": {
      "type": "object",
      "required": [
        "id",
        "target",
        "binding",
        "expectations",
        "provenance"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/scopedId"
        },
        "target": {
          "$ref": "#/$defs/regionAddress"
        },
        "binding": {
          "enum": [
            "pinned",
            "tracking",
            "floating"
          ]
        },
        "expectations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/expectation"
          }
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/provenance"
          }
        }
      },
      "additionalProperties": false
    },
    "annotationObject": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "region"
          ],
          "properties": {
            "kind": {
              "const": "region"
            },
            "region": {
              "$ref": "#/$defs/regionRef"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "reference"
          ],
          "properties": {
            "kind": {
              "const": "reference"
            },
            "reference": {
              "$ref": "#/$defs/scopedId"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "literal"
            },
            "value": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "materialization": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "artifact",
            "range"
          ],
          "properties": {
            "kind": {
              "enum": [
                "markdown-inline",
                "source-comment"
              ]
            },
            "artifact": {
              "type": "string",
              "minLength": 1
            },
            "range": {
              "$ref": "#/$defs/range"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "artifact"
          ],
          "properties": {
            "kind": {
              "const": "sidecar"
            },
            "artifact": {
              "type": "string",
              "minLength": 1
            },
            "path": {
              "$ref": "#/$defs/path"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "artifact"
          ],
          "properties": {
            "kind": {
              "const": "generated-index"
            },
            "artifact": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "annotation": {
      "type": "object",
      "required": [
        "id",
        "subject",
        "predicate",
        "object",
        "provenance",
        "materialization"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/scopedId"
        },
        "subject": {
          "$ref": "#/$defs/regionRef"
        },
        "predicate": {
          "type": "string",
          "minLength": 1
        },
        "object": {
          "$ref": "#/$defs/annotationObject"
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/provenance"
          }
        },
        "materialization": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/materialization"
          }
        }
      },
      "additionalProperties": false
    },
    "capability": {
      "type": "object",
      "required": ["type", "name", "version"],
      "properties": {
        "type": {
          "enum": [
            "artifact-provider",
            "interpreter",
            "annotation-extractor",
            "deriver",
            "auditor",
            "renderer",
            "indexer"
          ]
        },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "appliesTo": {
          "type": "object",
          "required": ["mediaTypes", "pathGlobs"],
          "properties": {
            "mediaTypes": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "pathGlobs": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            }
          },
          "anyOf": [
            { "properties": { "mediaTypes": { "minItems": 1 } } },
            { "properties": { "pathGlobs": { "minItems": 1 } } }
          ],
          "additionalProperties": false
        },
        "schemas": {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "selector": { "type": "string", "minLength": 1 },
            "annotation": { "type": "string", "minLength": 1 },
            "options": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "snapshot": {
      "type": "object",
      "required": [
        "target",
        "artifactIdentity",
        "observedAt"
      ],
      "properties": {
        "target": {
          "type": "object",
          "required": [
            "artifact",
            "selector"
          ],
          "properties": {
            "artifact": {
              "$ref": "#/$defs/origin"
            },
            "selector": {
              "$ref": "#/$defs/selector"
            },
            "interpreter": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "artifactIdentity": {
          "$ref": "#/$defs/contentIdentity"
        },
        "regionFingerprint": {
          "type": "string"
        },
        "display": {
          "type": "string"
        },
        "observedAt": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "changedArtifact": {
      "type": "object",
      "required": [
        "path",
        "after"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "before": {
          "$ref": "#/$defs/contentIdentity"
        },
        "after": {
          "$ref": "#/$defs/contentIdentity"
        }
      },
      "additionalProperties": false
    },
    "conflict": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "patchId",
            "target",
            "actual"
          ],
          "properties": {
            "kind": {
              "const": "artifact-already-exists"
            },
            "patchId": {
              "type": "string",
              "minLength": 1
            },
            "target": {
              "$ref": "#/$defs/path"
            },
            "actual": {
              "$ref": "#/$defs/contentIdentity"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "patchId",
            "target"
          ],
          "properties": {
            "kind": {
              "const": "missing-artifact"
            },
            "patchId": {
              "type": "string",
              "minLength": 1
            },
            "target": {
              "$ref": "#/$defs/path"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "patchId",
            "target",
            "expected",
            "actual"
          ],
          "properties": {
            "kind": {
              "const": "identity-mismatch"
            },
            "patchId": {
              "type": "string",
              "minLength": 1
            },
            "target": {
              "$ref": "#/$defs/path"
            },
            "expected": {
              "$ref": "#/$defs/contentIdentity"
            },
            "actual": {
              "$ref": "#/$defs/contentIdentity"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "patchId",
            "target",
            "declared",
            "actual"
          ],
          "properties": {
            "kind": {
              "const": "result-identity-mismatch"
            },
            "patchId": {
              "type": "string",
              "minLength": 1
            },
            "target": {
              "$ref": "#/$defs/path"
            },
            "declared": {
              "$ref": "#/$defs/contentIdentity"
            },
            "actual": {
              "$ref": "#/$defs/contentIdentity"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "patchId",
            "target",
            "range",
            "contentLength"
          ],
          "properties": {
            "kind": {
              "const": "range-out-of-bounds"
            },
            "patchId": {
              "type": "string",
              "minLength": 1
            },
            "target": {
              "$ref": "#/$defs/path"
            },
            "range": {
              "$ref": "#/$defs/range"
            },
            "contentLength": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "patchId",
            "target",
            "left",
            "right"
          ],
          "properties": {
            "kind": {
              "const": "overlapping-edits"
            },
            "patchId": {
              "type": "string",
              "minLength": 1
            },
            "target": {
              "$ref": "#/$defs/path"
            },
            "left": {
              "$ref": "#/$defs/range"
            },
            "right": {
              "$ref": "#/$defs/range"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "patchId",
            "target",
            "reason"
          ],
          "properties": {
            "kind": {
              "const": "filesystem-safety"
            },
            "patchId": {
              "type": "string",
              "minLength": 1
            },
            "target": {
              "$ref": "#/$defs/path"
            },
            "reason": {
              "enum": [
                "invalid-native-path",
                "path-escapes-workspace",
                "symlink-component",
                "target-is-symlink",
                "parent-not-directory",
                "target-not-regular-file",
                "native-spelling-mismatch",
                "reparse-point"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
