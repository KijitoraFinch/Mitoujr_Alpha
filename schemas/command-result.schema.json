        "metadataDiscovered",
        "metadataDecoded",
        "metadataFailed",
        "complete"
      ],
      "properties": {
        "primaryResources": { "$ref": "#/$defs/nonNegativeSafeInteger" },
        "observed": { "$ref": "#/$defs/nonNegativeSafeInteger" },
        "interpreted": { "$ref": "#/$defs/nonNegativeSafeInteger" },
        "unsupported": { "$ref": "#/$defs/nonNegativeSafeInteger" },
        "failed": { "$ref": "#/$defs/nonNegativeSafeInteger" },
        "metadataDiscovered": { "$ref": "#/$defs/nonNegativeSafeInteger" },
        "metadataDecoded": { "$ref": "#/$defs/nonNegativeSafeInteger" },
        "metadataFailed": { "$ref": "#/$defs/nonNegativeSafeInteger" },
        "complete": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "capability": {
      "type": "object",
      "required": [
        "type",
        "name",
        "version",
        "acceptedObservationTypes",
        "applicability",
        "selectorSchemas",
        "resultSchemas"
      ],
      "properties": {
        "type": {
          "enum": [
            "resource-observer",
            "interpreter",
            "annotation-extractor",
            "reference-extractor",
            "deriver",
