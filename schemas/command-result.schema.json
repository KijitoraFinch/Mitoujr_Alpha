{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://monika.local/schemas/command-result.schema.json",
  "title": "CommandResult",
  "type": "object",
  "required": [
    "schemaVersion",
    "command",
    "status",
    "diagnostics",
    "patches",
    "changedFiles",
    "conflicts",
    "snapshots",
    "observations",
    "sidecarSnapshots",
    "regions",
    "references",
    "annotations",
    "referenceDefinitions",
    "referenceUses",
    "annotationOccurrences",
    "capabilities",
    "coverage",
    "exitClass"
  ],
  "properties": {
    "schemaVersion": {
      "const": "11"
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "ok",
        "diagnostics-found",
        "patches-proposed",
        "applied",
        "conflict",
        "invalid-input",
        "internal-error"
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "patches": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/patch"
      }
    },
    "changedFiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/changedFile"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/conflict"
      }
    },
    "snapshots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/snapshot"
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "sidecarSnapshots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sidecarSnapshot"
      }
    },
    "regions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/region"
      }
    },
    "references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference"
      }
    },
    "annotations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/annotation"
      }
    },
    "referenceDefinitions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/referenceDefinitionOccurrence"
      }
    },
    "referenceUses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/referenceUse"
      }
    },
    "annotationOccurrences": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/annotationOccurrence"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "summary": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          {
            "type": "string"
          },
          {
            "type": "boolean"
          }
        ]
      }
    },
    "exitClass": {
      "enum": [
        "success",
        "diagnostic-error",
        "usage-error",
        "internal-error"
      ]
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "oneOf": [
        {
          "required": [
            "status",
            "diagnostics",
            "patches",
            "changedFiles",
            "conflicts"
          ],
          "properties": {
            "status": {
              "const": "ok"
            },
            "diagnostics": {
              "maxItems": 0
            },
            "patches": {
              "maxItems": 0
            },
            "changedFiles": {
              "maxItems": 0
            },
            "conflicts": {
              "maxItems": 0
            }
          }
        },
        {
          "required": [
            "status",
            "diagnostics",
            "patches",
            "changedFiles",
            "conflicts"
          ],
          "properties": {
            "status": {
              "const": "diagnostics-found"
            },
            "diagnostics": {
              "minItems": 1
            },
            "patches": {
              "maxItems": 0
            },
            "changedFiles": {
              "maxItems": 0
            },
            "conflicts": {
              "maxItems": 0
            }
          }
        },
        {
          "required": [
            "status",
            "patches",
            "changedFiles",
            "conflicts"
          ],
          "properties": {
            "status": {
              "const": "patches-proposed"
            },
            "patches": {
              "minItems": 1
            },
            "changedFiles": {
              "maxItems": 0
            },
            "conflicts": {
              "maxItems": 0
            }
          }
        },
        {
          "required": [
            "status",
            "patches",
            "changedFiles",
            "conflicts"
          ],
          "properties": {
            "status": {
              "const": "applied"
            },
            "patches": {
              "maxItems": 0
            },
            "changedFiles": {
              "minItems": 1
            },
            "conflicts": {
              "maxItems": 0
            }
          }
        },
        {
          "required": [
            "status",
            "patches",
            "changedFiles",
            "conflicts"
          ],
          "properties": {
            "status": {
              "const": "conflict"
            },
            "patches": {
              "maxItems": 0
            },
            "changedFiles": {
              "maxItems": 0
            },
            "conflicts": {
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "status",
            "patches",
            "changedFiles",
            "conflicts"
          ],
          "properties": {
            "status": {
              "const": "invalid-input"
            },
            "patches": {
              "maxItems": 0
            },
            "changedFiles": {
              "maxItems": 0
            },
            "conflicts": {
              "maxItems": 0
            }
          }
        },
        {
          "required": [
            "status",
            "patches",
            "changedFiles",
            "conflicts"
          ],
          "properties": {
            "status": {
              "const": "internal-error"
            },
            "patches": {
              "maxItems": 0
            },
            "changedFiles": {
              "maxItems": 0
            },
            "conflicts": {
              "maxItems": 0
            }
          }
        }
      ]
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "invalid-input"
          }
        }
      },
      "then": {
        "properties": {
          "exitClass": {
            "const": "usage-error"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "internal-error"
          }
        }
      },
      "then": {
        "properties": {
          "exitClass": {
            "const": "internal-error"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "conflict"
          }
        }
      },
      "then": {
        "properties": {
          "exitClass": {
            "const": "diagnostic-error"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "ok",
              "diagnostics-found",
              "patches-proposed",
              "applied"
            ]
          },
          "diagnostics": {
            "contains": {
              "type": "object",
              "required": [
                "effectiveSeverity"
              ],
              "properties": {
                "effectiveSeverity": {
                  "const": "error"
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "exitClass": {
            "const": "diagnostic-error"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "ok",
              "diagnostics-found",
              "patches-proposed",
              "applied"
            ]
          },
          "diagnostics": {
            "not": {
              "contains": {
                "type": "object",
                "required": [
                  "effectiveSeverity"
                ],
                "properties": {
                  "effectiveSeverity": {
                    "const": "error"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "exitClass": {
            "const": "success"
          }
        }
      }
    }
  ],
  "$defs": {
    "nonNegativeSafeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "protocolValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "string" },
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/protocolValue" }
        },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/protocolValue" }
        }
      ]
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!(?:\\.{1,2})(?:/|$))(?:[A-Za-z0-9._~-]|%(?:0[1-9A-F]|1[0-9A-F]|2[0-9A-C]|3[A-F]|40|5[B-E]|60|7[B-D]|7F|[89A-F][0-9A-F]))+(?:/(?!(?:\\.{1,2})(?:/|$))(?:[A-Za-z0-9._~-]|%(?:0[1-9A-F]|1[0-9A-F]|2[0-9A-C]|3[A-F]|40|5[B-E]|60|7[B-D]|7F|[89A-F][0-9A-F]))+)*(?![\\s\\S])"
    },
    "contentIdentity": {
      "type": "object",
      "required": [
        "hash",
        "size"
      ],
      "properties": {
        "hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "schemaValue": {
      "type": "object",
      "required": ["schema", "value"],
      "properties": {
        "schema": { "type": "string", "minLength": 1 },
        "value": { "$ref": "#/$defs/protocolValue" }
      },
      "additionalProperties": false
    },
    "range": {
      "description": "A zero-based half-open [start, end) range measured in bytes of the exact observation content. Text offsets count UTF-8 bytes, not Unicode code points or UTF-16 code units.",
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "end": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "detail": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "edit": {
      "type": "object",
      "required": [
        "range",
        "replacement"
      ],
      "properties": {
        "range": {
          "$ref": "#/$defs/range"
        },
        "replacement": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "patch": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "id",
            "operation",
            "target",
            "resultingContentIdentity",
            "content",
            "reason",
            "provenance"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "operation": {
              "const": "create"
            },
            "target": {
              "$ref": "#/$defs/path"
            },
            "resultingContentIdentity": {
              "$ref": "#/$defs/contentIdentity"
            },
            "content": {
              "type": "string"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "provenance": {
              "$ref": "#/$defs/provenance"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "id",
            "operation",
            "target",
            "expectedContentIdentity",
            "resultingContentIdentity",
            "edits",
            "reason",
            "provenance"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "operation": {
              "const": "edit"
            },
            "target": {
              "$ref": "#/$defs/path"
            },
            "expectedContentIdentity": {
              "$ref": "#/$defs/contentIdentity"
            },
            "resultingContentIdentity": {
              "$ref": "#/$defs/contentIdentity"
            },
            "edits": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/edit"
              }
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "provenance": {
              "$ref": "#/$defs/provenance"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "scopedId": {
      "type": "object",
      "required": [
        "observation",
        "local"
      ],
      "properties": {
        "observation": {
          "type": "string",
          "minLength": 1
        },
        "local": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "location": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "observation": {
          "type": "string",
          "minLength": 1
        },
        "region": {
          "$ref": "#/$defs/scopedId"
        },
        "annotation": {
          "$ref": "#/$defs/originScopedId"
        },
        "range": {
          "$ref": "#/$defs/range"
        }
      },
      "additionalProperties": false
    },
    "extensionFailure": {
      "type": "object",
      "required": ["operation", "code"],
      "properties": {
        "operation": {
          "enum": [
            "session",
            "observe-resource",
            "interpret-observation",
            "extract-annotations",
            "extract-references",
            "resolve-region",
            "classify-region-extents",
            "audit",
            "derive"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "data": { "$ref": "#/$defs/protocolValue" }
      },
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "required": [
        "code",
        "defaultSeverity",
        "effectiveSeverity",
        "message",
        "suggestedFixes"
      ],
      "properties": {
        "code": {
          "enum": [
            "sidecar-only",
            "inline-only",
            "divergent",
            "stale-selector",
            "duplicate",
            "unreferenced-ref",
            "unresolved-ref",
            "expectation-failed",
            "resolution-changed",
            "invalid-sidecar",
            "invalid-selector",
            "unsupported-observation",
            "unsupported-filesystem-entry",
            "observation-failure",
            "metadata-failure",
            "extension-failure"
          ]
        },
        "defaultSeverity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "effectiveSeverity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "extensionFailure": {
          "$ref": "#/$defs/extensionFailure"
        },
        "suggestedFixes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/patch"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "code": {
                "const": "sidecar-only"
              }
            }
          },
          "then": {
            "properties": {
              "defaultSeverity": {
                "const": "info"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "enum": [
                  "inline-only",
                  "duplicate",
                  "unreferenced-ref",
                  "resolution-changed",
                  "unsupported-observation",
                  "unsupported-filesystem-entry"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "defaultSeverity": {
                "const": "warning"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "enum": [
                  "divergent",
                  "stale-selector",
                  "unresolved-ref",
                  "expectation-failed",
                  "invalid-sidecar",
                  "invalid-selector",
                  "observation-failure",
                  "metadata-failure",
                  "extension-failure"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "defaultSeverity": {
                "const": "error"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": { "const": "extension-failure" }
            }
          },
          "then": {
            "required": ["extensionFailure"]
          }
        },
        {
          "if": {
            "required": ["extensionFailure"]
          },
          "then": {
            "properties": {
              "code": {
                "enum": [
                  "extension-failure",
                  "unsupported-observation",
                  "unresolved-ref",
                  "invalid-selector"
                ]
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "origin": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "path"
          ],
          "properties": {
            "kind": {
              "const": "workspace"
            },
            "path": {
              "$ref": "#/$defs/path"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "repo",
            "path"
          ],
          "properties": {
            "kind": {
              "const": "git"
            },
            "repo": {
              "type": "string",
              "minLength": 1
            },
            "rev": {
              "type": "string",
              "minLength": 1
            },
            "path": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "url"
          ],
          "properties": {
            "kind": {
              "const": "web"
            },
            "url": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "name"
          ],
          "properties": {
            "kind": {
              "const": "generated"
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "uri"
          ],
          "properties": {
            "kind": {
              "const": "external"
            },
            "uri": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "observer",
            "locator"
          ],
          "properties": {
            "kind": {
              "const": "extension"
            },
            "observer": {
              "type": "object",
              "required": ["name", "version"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "version": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            },
            "locator": {
              "$ref": "#/$defs/protocolValue"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "originScopedId": {
      "type": "object",
      "required": ["scope", "local"],
      "properties": {
        "scope": { "$ref": "#/$defs/origin" },
        "local": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "selector": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "whole-observation"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "const": "region-id"
            },
            "id": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "range"
          ],
          "properties": {
            "kind": {
              "const": "text-range"
            },
            "range": {
              "$ref": "#/$defs/range"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "where"
          ],
          "properties": {
            "kind": {
              "const": "row-filter"
            },
            "where": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {
                "minLength": 1
              },
              "additionalProperties": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "boolean"
                  }
                ]
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "schema",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "extension"
            },
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "value": true
          },
          "additionalProperties": false
        }
      ]
    },
    "observationType": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "observationIdentity": {
      "type": "object",
      "required": [
        "observationType",
        "key"
      ],
      "properties": {
        "observationType": {
          "$ref": "#/$defs/observationType"
        },
        "key": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "required": [
        "id",
        "origin",
        "identity",
        "representation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "$ref": "#/$defs/origin"
        },
        "identity": {
          "$ref": "#/$defs/observationIdentity"
        },
        "representation": {
          "oneOf": [
            {
              "type": "object",
              "required": ["kind"],
              "properties": { "kind": { "const": "bytes" } },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["kind", "schema", "value"],
              "properties": {
                "kind": { "const": "structured" },
                "schema": { "type": "string", "minLength": 1 },
                "value": { "$ref": "#/$defs/protocolValue" }
              },
              "additionalProperties": false
            }
          ]
        },
        "contentIdentity": {
          "$ref": "#/$defs/contentIdentity"
        }
      },
      "additionalProperties": false
    },
    "regionAddress": {
      "type": "object",
      "required": [
        "origin",
        "selector"
      ],
      "properties": {
        "origin": {
          "$ref": "#/$defs/origin"
        },
        "selector": {
          "$ref": "#/$defs/selector"
        },
        "interpreter": {
          "type": "string",
          "minLength": 1
        },
        "interpreterVersion": {
          "type": "string",
          "minLength": 1
        },
        "expectation": {
          "$ref": "#/$defs/expectation"
        }
      },
      "dependentRequired": {
        "interpreter": ["interpreterVersion"],
        "interpreterVersion": ["interpreter"]
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "selector": {
                "required": ["kind"],
                "properties": {"kind": {"const": "whole-observation"}}
              }
            },
            "required": ["selector"]
          },
          "then": {
            "not": {
              "anyOf": [
                {"required": ["interpreter"]},
                {"required": ["interpreterVersion"]}
              ]
            }
          },
          "else": {"required": ["interpreter", "interpreterVersion"]}
        }
      ],
      "additionalProperties": false
    },
    "regionRef": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "const": "resolved"
            },
            "id": {
              "$ref": "#/$defs/scopedId"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "address"
          ],
          "properties": {
            "kind": {
              "const": "address"
            },
            "address": {
              "$ref": "#/$defs/regionAddress"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "region": {
      "type": "object",
      "required": [
        "id",
        "selector"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/scopedId"
        },
        "selector": {
          "$ref": "#/$defs/selector"
        },
        "interpreter": {
          "type": "string",
          "minLength": 1
        },
        "interpreterVersion": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string"
        },
        "range": {
          "$ref": "#/$defs/range"
        },
        "fingerprint": {
          "$ref": "#/$defs/schemaValue"
        }
      },
      "dependentRequired": {
        "interpreter": ["interpreterVersion"],
        "interpreterVersion": ["interpreter"]
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "selector": {
                "required": ["kind"],
                "properties": {"kind": {"const": "whole-observation"}}
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {"required": ["interpreter"]},
                {"required": ["interpreterVersion"]}
              ]
            }
          },
          "else": {"required": ["interpreter", "interpreterVersion"]}
        }
      ],
      "additionalProperties": false
    },
    "expectation": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "observationIdentity"
          ],
          "properties": {
            "kind": { "const": "observation-identity" },
            "observationIdentity": { "$ref": "#/$defs/observationIdentity" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "contentIdentity"],
          "properties": {
            "kind": { "const": "content-identity" },
            "contentIdentity": { "$ref": "#/$defs/contentIdentity" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "schema", "value"],
          "properties": {
            "kind": { "const": "revision" },
            "schema": { "type": "string", "minLength": 1 },
            "value": { "$ref": "#/$defs/protocolValue" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "schema", "value"],
          "properties": {
            "kind": { "const": "fingerprint" },
            "schema": { "type": "string", "minLength": 1 },
            "value": { "$ref": "#/$defs/protocolValue" }
          },
          "additionalProperties": false
        }
      ]
    },
    "reference": {
      "type": "object",
      "required": [
        "id",
        "target",
        "binding",
        "expectations"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/originScopedId"
        },
        "target": {
          "$ref": "#/$defs/regionAddress"
        },
        "binding": {
          "enum": [
            "pinned",
            "tracking",
            "floating"
          ]
        },
        "expectations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/expectation"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "binding": { "const": "pinned" } }
          },
          "then": {
            "anyOf": [
              { "properties": { "expectations": { "minItems": 1 } } },
              {
                "properties": {
                  "target": { "required": ["expectation"] }
                }
              }
            ]
          },
          "else": {
            "properties": { "expectations": { "maxItems": 0 } }
          }
        }
      ],
      "additionalProperties": false
    },
    "annotationObject": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "region"
          ],
          "properties": {
            "kind": {
              "const": "region"
            },
            "region": {
              "$ref": "#/$defs/regionRef"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "reference"
          ],
          "properties": {
            "kind": {
              "const": "reference"
            },
            "reference": {
              "$ref": "#/$defs/originScopedId"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "literal"
            },
            "value": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "annotation": {
      "type": "object",
      "required": [
        "id",
        "subject",
        "predicate",
        "object"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/originScopedId"
        },
        "subject": {
          "$ref": "#/$defs/regionRef"
        },
        "predicate": {
          "type": "string",
          "minLength": 1
        },
        "object": {
          "$ref": "#/$defs/annotationObject"
        }
      },
      "additionalProperties": false
    },
    "structuredLocation": {
      "type": "object",
      "required": ["schema", "value"],
      "properties": {
        "schema": { "type": "string", "minLength": 1 },
        "value": { "$ref": "#/$defs/protocolValue" }
      },
