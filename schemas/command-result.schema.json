            "locator": { "$ref": "#/$defs/observationLocator" },
            "encoding": { "$ref": "#/$defs/observationEncoding" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "path",
            "contentIdentity",
            "locator",
            "ownership"
          ],
          "properties": {
            "kind": { "const": "sidecar" },
            "path": { "$ref": "#/$defs/path" },
            "contentIdentity": { "$ref": "#/$defs/contentIdentity" },
            "locator": { "$ref": "#/$defs/structuredLocation" },
            "ownership": { "enum": ["authored", "derived"] }
          },
          "additionalProperties": false
        }
      ]
    },
    "annotationOccurrence": {
      "type": "object",
      "required": ["annotation", "source"],
      "properties": {
        "annotation": { "$ref": "#/$defs/annotation" },
