              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        "selectorSchemas": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "resultSchemas": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "snapshot": {
      "type": "object",
      "required": [
        "target",
        "observationIdentity",
        "observedAt"
      ],
      "properties": {
        "target": {
          "$ref": "#/$defs/regionAddress"
        },
        "observationIdentity": {
          "$ref": "#/$defs/observationIdentity"
