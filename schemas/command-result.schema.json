              "const": "missing-target"
            },
            "patchId": {
              "type": "string",
              "minLength": 1
            },
            "target": {
              "$ref": "#/$defs/path"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "patchId",
            "target",
            "expected",
            "actual"
          ],
          "properties": {
            "kind": {
              "const": "identity-mismatch"
            },
            "patchId": {
              "type": "string",
              "minLength": 1
            },
            "target": {
              "$ref": "#/$defs/path"
            },
            "expected": {
              "$ref": "#/$defs/contentIdentity"
            },
            "actual": {
              "$ref": "#/$defs/contentIdentity"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "patchId",
            "target",
            "declared",
            "actual"
          ],
          "properties": {
            "kind": {
              "const": "result-identity-mismatch"
            },
            "patchId": {
              "type": "string",
              "minLength": 1
            },
            "target": {
              "$ref": "#/$defs/path"
            },
            "declared": {
              "$ref": "#/$defs/contentIdentity"
            },
            "actual": {
              "$ref": "#/$defs/contentIdentity"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "patchId",
            "target",
            "range",
            "contentLength"
          ],
          "properties": {
            "kind": {
              "const": "range-out-of-bounds"
            },
            "patchId": {
              "type": "string",
              "minLength": 1
            },
            "target": {
              "$ref": "#/$defs/path"
            },
            "range": {
              "$ref": "#/$defs/range"
            },
            "contentLength": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "patchId",
            "target",
            "left",
            "right"
          ],
          "properties": {
            "kind": {
              "const": "overlapping-edits"
            },
            "patchId": {
              "type": "string",
              "minLength": 1
            },
            "target": {
              "$ref": "#/$defs/path"
            },
            "left": {
              "$ref": "#/$defs/range"
            },
            "right": {
              "$ref": "#/$defs/range"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "patchId",
            "target",
            "reason"
          ],
          "properties": {
            "kind": {
              "const": "filesystem-safety"
            },
            "patchId": {
              "type": "string",
              "minLength": 1
            },
            "target": {
              "$ref": "#/$defs/path"
            },
            "reason": {
              "enum": [
                "invalid-native-path",
                "path-escapes-workspace",
                "symlink-component",
                "target-is-symlink",
                "parent-not-directory",
                "target-not-regular-file",
                "native-spelling-mismatch",
                "reparse-point"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
