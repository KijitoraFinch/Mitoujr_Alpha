{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://monika.local/schemas/diagnostic-list.schema.json",
  "title": "DiagnosticList",
  "description": "Deterministically ordered diagnostics emitted by an Auditor.",
