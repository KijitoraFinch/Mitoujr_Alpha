{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://monika.dev/schemas/report-bundle-manifest.schema.json",
  "title": "Monika Report Bundle Manifest",
  "oneOf": [
    {
      "$ref": "#/$defs/sessionReport"
    },
    {
      "$ref": "#/$defs/contentReport"
    }
  ],
  "$defs": {
    "sessionReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "reportId",
        "createdAt",
        "destination",
        "codex",
        "files"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1"
        },
        "reportId": {
          "$ref": "#/$defs/reportId"
        },
        "createdAt": {
          "$ref": "#/$defs/createdAt"
        },
        "destination": {
          "$ref": "#/$defs/destination"
        },
        "codex": {
          "$ref": "#/$defs/codex"
        },
        "files": {
          "$ref": "#/$defs/sessionFiles"
        }
      }
    },
    "contentReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "reportKind",
        "sessionIncluded",
        "reportId",
        "createdAt",
        "destination",
        "files"
      ],
      "properties": {
        "schemaVersion": {
          "const": "content-1"
        },
        "reportKind": {
          "enum": ["proposal", "issue", "complaint", "feedback"]
        },
        "sessionIncluded": {
          "const": false
        },
        "reportId": {
          "$ref": "#/$defs/reportId"
        },
        "createdAt": {
          "$ref": "#/$defs/createdAt"
        },
        "destination": {
          "$ref": "#/$defs/destination"
        },
        "files": {
          "$ref": "#/$defs/contentFiles"
        }
      }
    },
    "reportId": {
      "type": "string",
      "format": "uuid"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "releaseTag"],
      "properties": {
        "repository": {
          "const": "MitouJr-2026/reports"
        },
        "releaseTag": {
          "const": "report-inbox"
        }
      }
    },
    "codex": {
      "type": "object",
      "additionalProperties": false,
      "required": ["threadId", "sourceBasename", "captureBoundary"],
      "properties": {
        "threadId": {
          "type": "string",
          "minLength": 1
        },
        "sourceBasename": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/\\\\]+\\.jsonl$"
        },
        "captureBoundary": {
          "const": "complete-lines-prefix"
        }
      }
    },
    "sessionFiles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report.md",
        "codex/doctor.json",
        "codex/session.jsonl",
        "monika/version.txt"
      ],
      "properties": {
        "report.md": {
          "$ref": "#/$defs/fileIdentity"
        },
        "codex/doctor.json": {
          "$ref": "#/$defs/fileIdentity"
        },
        "codex/session.jsonl": {
          "$ref": "#/$defs/fileIdentity"
        },
        "monika/version.txt": {
          "$ref": "#/$defs/fileIdentity"
        }
      }
    },
    "contentFiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report.md", "monika/version.txt"],
      "properties": {
        "report.md": {
          "$ref": "#/$defs/fileIdentity"
        },
        "monika/version.txt": {
          "$ref": "#/$defs/fileIdentity"
        }
      }
    },
    "fileIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "sha256"],
      "properties": {
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
