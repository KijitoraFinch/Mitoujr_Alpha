{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://monika.local/schemas/extension-runtime-initialize-session.schema.json",
  "title": "Extension runtime session initialization exchange",
  "description": "JSON-RPC 2.0 request and response messages for monika.initializeSession over the version 1 stdio transport.",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/successResponse" },
    { "$ref": "#/$defs/errorResponse" }
  ],
  "$defs": {
    "safeInteger": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "protocolValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "string" },
        { "$ref": "#/$defs/safeInteger" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/protocolValue" }
        },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/protocolValue" }
        }
      ]
    },
    "request": {
      "type": "object",
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "method": { "const": "monika.initializeSession" },
        "params": {
          "type": "object",
          "required": ["protocolVersions", "maxMessageBytes"],
          "properties": {
            "protocolVersions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "maxMessageBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "successResponse": {
      "type": "object",
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "result": {
          "type": "object",
          "required": ["protocolVersion", "capability", "maxMessageBytes"],
          "properties": {
            "protocolVersion": { "const": "1" },
            "capability": { "$ref": "capability.schema.json" },
            "maxMessageBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "errorResponse": {
      "type": "object",
      "required": ["jsonrpc", "id", "error"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": {
          "oneOf": [
            { "$ref": "#/$defs/id" },
            { "type": "null" }
          ]
        },
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": { "$ref": "#/$defs/safeInteger" },
            "message": { "type": "string", "minLength": 1 },
            "data": { "$ref": "#/$defs/protocolValue" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
