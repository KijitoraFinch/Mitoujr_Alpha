{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://monika.dev/schemas/release-manifest.schema.json",
  "title": "Monika Binary Release Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["assets", "commit", "schemaVersion", "tag", "version"],
  "properties": {
    "assets": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        {
          "$ref": "#/$defs/linuxX86_64Asset"
        },
        {
          "$ref": "#/$defs/macosAarch64Asset"
        },
        {
          "$ref": "#/$defs/macosX86_64Asset"
        },
        {
          "$ref": "#/$defs/windowsX86_64Asset"
        },
        {
          "$ref": "#/$defs/skillsAsset"
        }
      ],
      "items": false
    },
    "commit": {
      "$ref": "#/$defs/commit"
    },
    "schemaVersion": {
      "const": "1"
    },
    "tag": {
      "type": "string",
      "pattern": "^v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?$"
    },
    "version": {
      "$ref": "#/$defs/version"
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "cliAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture",
        "bytes",
        "kind",
        "name",
        "platform",
        "sha256"
      ],
      "properties": {
        "architecture": {
          "enum": ["aarch64", "x86_64"]
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "kind": {
          "const": "cli"
        },
        "name": {
          "type": "string",
          "pattern": "^monika-[^/\\\\]+-(?:linux-x86_64|macos-aarch64|macos-x86_64|windows-x86_64)(?:\\.exe)?$"
        },
        "platform": {
          "enum": ["linux", "macos", "windows"]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "skillsAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "kind", "name", "sha256"],
      "properties": {
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "kind": {
          "const": "skills"
        },
        "name": {
          "type": "string",
          "pattern": "^monika-skills-[^/\\\\]+\\.zip$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "linuxX86_64Asset": {
      "allOf": [
        {
          "$ref": "#/$defs/cliAsset"
        },
        {
          "properties": {
            "architecture": {
              "const": "x86_64"
            },
            "name": {
              "pattern": "^monika-[^/\\\\]+-linux-x86_64$"
            },
            "platform": {
              "const": "linux"
            }
          }
        }
      ]
    },
    "macosAarch64Asset": {
      "allOf": [
        {
          "$ref": "#/$defs/cliAsset"
        },
        {
          "properties": {
            "architecture": {
              "const": "aarch64"
            },
            "name": {
              "pattern": "^monika-[^/\\\\]+-macos-aarch64$"
            },
            "platform": {
              "const": "macos"
            }
          }
        }
      ]
    },
    "macosX86_64Asset": {
      "allOf": [
        {
          "$ref": "#/$defs/cliAsset"
        },
        {
          "properties": {
            "architecture": {
              "const": "x86_64"
            },
            "name": {
              "pattern": "^monika-[^/\\\\]+-macos-x86_64$"
            },
            "platform": {
              "const": "macos"
            }
          }
        }
      ]
    },
    "windowsX86_64Asset": {
      "allOf": [
        {
          "$ref": "#/$defs/cliAsset"
        },
        {
          "properties": {
            "architecture": {
              "const": "x86_64"
            },
            "name": {
              "pattern": "^monika-[^/\\\\]+-windows-x86_64\\.exe$"
            },
            "platform": {
              "const": "windows"
            }
          }
        }
      ]
    }
  }
}
