{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://monika.local/schemas/extension-runtime-methods.schema.json",
  "title": "Extension runtime method exchange",
  "description": "JSON-RPC 2.0 method messages and host-owned content-stream notifications for Extension protocol version 1.",
  "anyOf": [
    { "$ref": "#/$defs/interpretObservationRequest" },
    { "$ref": "#/$defs/interpretObservationSuccessResponse" },
    { "$ref": "#/$defs/extractAnnotationsRequest" },
    { "$ref": "#/$defs/extractAnnotationsSuccessResponse" },
    { "$ref": "#/$defs/extractReferencesRequest" },
    { "$ref": "#/$defs/extractReferencesSuccessResponse" },
    { "$ref": "#/$defs/resolveRegionRequest" },
    { "$ref": "#/$defs/resolveRegionSuccessResponse" },
    { "$ref": "#/$defs/classifyRegionExtentsRequest" },
    { "$ref": "#/$defs/classifyRegionExtentsSuccessResponse" },
    { "$ref": "#/$defs/auditRequest" },
    { "$ref": "#/$defs/auditSuccessResponse" },
    { "$ref": "#/$defs/deriveRequest" },
    { "$ref": "#/$defs/deriveSuccessResponse" },
    { "$ref": "#/$defs/observeResourceRequest" },
    { "$ref": "#/$defs/observeResourceSuccessResponse" },
    { "$ref": "#/$defs/contentChunkNotification" },
    { "$ref": "#/$defs/endContentNotification" },
    { "$ref": "#/$defs/outputContentChunkNotification" },
    { "$ref": "#/$defs/endOutputContentNotification" },
    { "$ref": "#/$defs/errorResponse" }
  ],
  "$defs": {
    "safeInteger": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "protocolValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "string" },
        { "$ref": "#/$defs/safeInteger" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/protocolValue" }
        },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/protocolValue" }
        }
      ]
    },
    "content": {
      "type": "object",
      "required": ["kind", "byteLength"],
      "properties": {
        "kind": { "const": "byteStream" },
        "byteLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "contentMatchesRepresentation": {
      "if": {
        "properties": {
          "observation": {
            "properties": {
              "representation": {
                "properties": { "kind": { "const": "bytes" } },
                "required": ["kind"]
              }
            },
            "required": ["representation"]
          }
        },
        "required": ["observation"]
      },
      "then": { "required": ["content"] },
      "else": { "not": { "required": ["content"] } }
    },
    "failure": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "data": { "$ref": "#/$defs/protocolValue" }
      },
      "additionalProperties": false
    },
    "auditRequest": {
      "type": "object",
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "method": { "const": "monika.audit" },
        "params": {
          "type": "object",
          "required": ["snapshot", "policy"],
          "properties": {
            "snapshot": { "$ref": "workspace-graph-snapshot.schema.json" },
            "policy": { "$ref": "audit-policy.schema.json" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "auditSuccessResponse": {
      "type": "object",
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "result": {
          "type": "object",
          "oneOf": [
            { "required": ["diagnostics"] },
            { "required": ["failure"] }
          ],
          "properties": {
            "diagnostics": {
              "type": "array",
              "items": { "$ref": "diagnostic.schema.json" }
            },
            "failure": { "$ref": "#/$defs/failure" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "deriveRequest": {
      "type": "object",
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "method": { "const": "monika.derive" },
        "params": {
          "type": "object",
          "required": ["request", "snapshot"],
          "properties": {
            "request": { "$ref": "derive-request.schema.json" },
            "snapshot": { "$ref": "workspace-graph-snapshot.schema.json" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "deriveSuccessResponse": {
      "type": "object",
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "result": {
          "type": "object",
          "oneOf": [
            { "required": ["patches"] },
            { "required": ["failure"] }
          ],
          "properties": {
            "patches": {
              "type": "array",
              "items": { "$ref": "patch.schema.json" }
            },
            "failure": { "$ref": "#/$defs/failure" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "observeResourceRequest": {
      "type": "object",
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "method": { "const": "monika.observeResource" },
        "params": {
          "type": "object",
          "required": ["origin"],
          "properties": {
            "origin": { "$ref": "command-result.schema.json#/$defs/origin" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "observeResourceSuccessResponse": {
      "type": "object",
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "result": {
          "type": "object",
          "oneOf": [
            { "required": ["observation"] },
            { "required": ["failure"] }
          ],
          "properties": {
            "observation": { "$ref": "observation.schema.json" },
            "failure": { "$ref": "#/$defs/failure" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "outputContentChunkNotification": {
      "type": "object",
      "required": ["jsonrpc", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "method": { "const": "monika.outputContentChunk" },
        "params": {
          "type": "object",
          "required": ["requestId", "offset", "base64"],
          "properties": {
            "requestId": { "$ref": "#/$defs/id" },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "base64": {
              "type": "string",
              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "endOutputContentNotification": {
      "type": "object",
      "required": ["jsonrpc", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "method": { "const": "monika.endOutputContent" },
        "params": {
          "type": "object",
          "required": ["requestId", "byteLength"],
          "properties": {
            "requestId": { "$ref": "#/$defs/id" },
            "byteLength": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "interpretObservationRequest": {
      "type": "object",
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "method": { "const": "monika.interpretObservation" },
        "params": {
          "type": "object",
          "required": ["observation"],
          "properties": {
            "observation": { "$ref": "observation.schema.json" },
            "content": { "$ref": "#/$defs/content" }
          },
          "allOf": [{ "$ref": "#/$defs/contentMatchesRepresentation" }],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "interpretObservationSuccessResponse": {
      "type": "object",
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "result": {
          "type": "object",
          "oneOf": [
            { "required": ["interpretation"] },
            { "required": ["failure"] }
          ],
          "properties": {
            "interpretation": { "$ref": "interpretation.schema.json" },
            "failure": { "$ref": "#/$defs/failure" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "referenceUse": {
      "type": "object",
      "required": ["sourceObservation", "sourceRegion", "sourceRange", "target"],
      "properties": {
        "sourceObservation": { "type": "string", "minLength": 1 },
        "sourceRegion": {
          "$ref": "command-result.schema.json#/$defs/referenceUseSourceRegion"
        },
        "sourceRange": { "$ref": "command-result.schema.json#/$defs/range" },
        "target": {
          "oneOf": [
            {
              "type": "object",
              "required": ["kind", "reference"],
              "properties": {
                "kind": { "const": "named" },
                "reference": {
                  "$ref": "command-result.schema.json#/$defs/originScopedId"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["kind", "address"],
              "properties": {
                "kind": { "const": "direct" },
                "address": {
                  "$ref": "command-result.schema.json#/$defs/regionAddress"
                }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "annotationExtraction": {
      "type": "object",
      "required": ["occurrences"],
      "properties": {
        "occurrences": {
          "type": "array",
          "items": { "$ref": "#/$defs/observationAnnotationOccurrence" }
        }
      },
      "additionalProperties": false
    },
    "observationAnnotationOccurrence": {
      "type": "object",
      "required": ["annotation", "source"],
      "properties": {
        "annotation": {
          "$ref": "command-result.schema.json#/$defs/annotation"
        },
        "source": {
          "type": "object",
          "required": ["kind", "observation", "locator", "encoding"],
          "properties": {
            "kind": { "const": "observation" },
            "observation": { "type": "string", "minLength": 1 },
            "locator": {
              "$ref": "command-result.schema.json#/$defs/observationLocator"
            },
            "encoding": {
              "$ref": "command-result.schema.json#/$defs/observationEncoding"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "extractAnnotationsRequest": {
      "type": "object",
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "method": { "const": "monika.extractAnnotations" },
        "params": {
          "type": "object",
          "required": ["observation"],
          "properties": {
            "observation": { "$ref": "observation.schema.json" },
            "interpretation": { "$ref": "interpretation.schema.json" },
            "content": { "$ref": "#/$defs/content" }
          },
          "allOf": [{ "$ref": "#/$defs/contentMatchesRepresentation" }],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "extractAnnotationsSuccessResponse": {
      "type": "object",
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "result": {
          "type": "object",
          "oneOf": [
            { "required": ["extraction"] },
            { "required": ["failure"] }
          ],
          "properties": {
            "extraction": { "$ref": "#/$defs/annotationExtraction" },
            "failure": { "$ref": "#/$defs/failure" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "referenceExtraction": {
      "type": "object",
      "required": ["definitions", "uses"],
      "properties": {
        "definitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/observationReferenceDefinitionOccurrence"
          }
        },
        "uses": {
          "type": "array",
          "items": { "$ref": "#/$defs/referenceUse" }
        }
      },
      "additionalProperties": false
    },
    "observationReferenceDefinitionOccurrence": {
      "type": "object",
      "required": ["reference", "source"],
      "properties": {
        "reference": {
          "$ref": "command-result.schema.json#/$defs/reference"
        },
        "source": {
          "$ref": "#/$defs/observationAnnotationOccurrence/properties/source"
        }
      },
      "additionalProperties": false
    },
    "extractReferencesRequest": {
      "type": "object",
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "method": { "const": "monika.extractReferences" },
        "params": {
          "type": "object",
          "required": ["observation"],
          "properties": {
            "observation": { "$ref": "observation.schema.json" },
            "interpretation": { "$ref": "interpretation.schema.json" },
            "content": { "$ref": "#/$defs/content" }
          },
          "allOf": [{ "$ref": "#/$defs/contentMatchesRepresentation" }],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "extractReferencesSuccessResponse": {
      "type": "object",
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "result": {
          "type": "object",
          "oneOf": [
            { "required": ["extraction"] },
            { "required": ["failure"] }
          ],
          "properties": {
            "extraction": { "$ref": "#/$defs/referenceExtraction" },
            "failure": { "$ref": "#/$defs/failure" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "resolveRegionRequest": {
      "type": "object",
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "method": { "const": "monika.resolveRegion" },
        "params": {
          "type": "object",
          "required": ["observation", "selector"],
          "properties": {
            "observation": { "$ref": "observation.schema.json" },
            "content": { "$ref": "#/$defs/content" },
            "selector": { "$ref": "command-result.schema.json#/$defs/selector" }
          },
          "allOf": [{ "$ref": "#/$defs/contentMatchesRepresentation" }],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "resolveRegionSuccessResponse": {
      "type": "object",
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "result": {
          "type": "object",
          "oneOf": [
            { "required": ["region"] },
            { "required": ["failure"] }
          ],
          "properties": {
            "region": { "$ref": "region.schema.json" },
            "failure": { "$ref": "#/$defs/failure" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "classifyRegionExtentsRequest": {
      "type": "object",
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "method": { "const": "monika.classifyRegionExtents" },
        "params": {
          "type": "object",
          "required": ["observation", "left", "right"],
          "properties": {
            "observation": { "$ref": "observation.schema.json" },
            "content": { "$ref": "#/$defs/content" },
            "left": { "$ref": "region.schema.json" },
            "right": { "$ref": "region.schema.json" }
          },
          "allOf": [{ "$ref": "#/$defs/contentMatchesRepresentation" }],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "classifyRegionExtentsSuccessResponse": {
      "type": "object",
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "result": {
          "type": "object",
          "oneOf": [
            { "required": ["relation"] },
            { "required": ["failure"] }
          ],
          "properties": {
            "relation": {
              "enum": ["equal", "contains", "contained-by", "overlaps", "disjoint"]
            },
            "failure": { "$ref": "#/$defs/failure" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "contentChunkNotification": {
      "type": "object",
      "required": ["jsonrpc", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "method": { "const": "monika.contentChunk" },
        "params": {
          "type": "object",
          "required": ["requestId", "offset", "base64"],
          "properties": {
            "requestId": { "$ref": "#/$defs/id" },
            "offset": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            "base64": { "type": "string", "pattern": "^[A-Za-z0-9+/]*={0,2}$" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "endContentNotification": {
      "type": "object",
      "required": ["jsonrpc", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "method": { "const": "monika.endContent" },
        "params": {
          "type": "object",
          "required": ["requestId", "byteLength"],
          "properties": {
            "requestId": { "$ref": "#/$defs/id" },
            "byteLength": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "errorResponse": {
      "type": "object",
      "required": ["jsonrpc", "id", "error"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": {
          "oneOf": [
            { "$ref": "#/$defs/id" },
            { "type": "null" }
          ]
        },
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": { "$ref": "#/$defs/safeInteger" },
            "message": { "type": "string", "minLength": 1 },
            "data": { "$ref": "#/$defs/protocolValue" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
