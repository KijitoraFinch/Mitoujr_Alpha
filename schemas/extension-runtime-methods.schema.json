{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://monika.local/schemas/extension-runtime-methods.schema.json",
  "title": "Extension runtime method exchange",
  "description": "JSON-RPC 2.0 method messages and host-owned content-stream notifications for Extension protocol version 1.",
  "anyOf": [
    { "$ref": "#/$defs/interpretObservationRequest" },
    { "$ref": "#/$defs/interpretObservationSuccessResponse" },
    { "$ref": "#/$defs/resolveRegionRequest" },
    { "$ref": "#/$defs/resolveRegionSuccessResponse" },
    { "$ref": "#/$defs/classifyRegionExtentsRequest" },
    { "$ref": "#/$defs/classifyRegionExtentsSuccessResponse" },
    { "$ref": "#/$defs/contentChunkNotification" },
    { "$ref": "#/$defs/endContentNotification" },
    { "$ref": "#/$defs/errorResponse" }
  ],
  "$defs": {
    "safeInteger": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "protocolValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "string" },
        { "$ref": "#/$defs/safeInteger" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/protocolValue" }
        },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/protocolValue" }
        }
      ]
    },
    "content": {
      "type": "object",
      "required": ["kind", "byteLength"],
      "properties": {
        "kind": { "const": "byteStream" },
        "byteLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "failure": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "data": { "$ref": "#/$defs/protocolValue" }
      },
      "additionalProperties": false
    },
    "interpretObservationRequest": {
      "type": "object",
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "method": { "const": "monika.interpretObservation" },
        "params": {
          "type": "object",
          "required": ["observation", "content"],
          "properties": {
            "observation": { "$ref": "observation.schema.json" },
            "content": { "$ref": "#/$defs/content" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "interpretObservationSuccessResponse": {
      "type": "object",
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "result": {
          "type": "object",
          "oneOf": [
            { "required": ["interpretation"] },
            { "required": ["failure"] }
          ],
          "properties": {
            "interpretation": { "$ref": "interpretation.schema.json" },
            "failure": { "$ref": "#/$defs/failure" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "resolveRegionRequest": {
      "type": "object",
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "method": { "const": "monika.resolveRegion" },
        "params": {
          "type": "object",
          "required": ["observation", "content", "selector"],
          "properties": {
            "observation": { "$ref": "observation.schema.json" },
            "content": { "$ref": "#/$defs/content" },
            "selector": { "$ref": "command-result.schema.json#/$defs/selector" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "resolveRegionSuccessResponse": {
      "type": "object",
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "result": {
          "type": "object",
          "oneOf": [
            { "required": ["region"] },
            { "required": ["failure"] }
          ],
          "properties": {
            "region": { "$ref": "region.schema.json" },
            "failure": { "$ref": "#/$defs/failure" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "classifyRegionExtentsRequest": {
      "type": "object",
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "method": { "const": "monika.classifyRegionExtents" },
        "params": {
          "type": "object",
          "required": ["observation", "content", "left", "right"],
          "properties": {
            "observation": { "$ref": "observation.schema.json" },
            "content": { "$ref": "#/$defs/content" },
            "left": { "$ref": "region.schema.json" },
            "right": { "$ref": "region.schema.json" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "classifyRegionExtentsSuccessResponse": {
      "type": "object",
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "result": {
          "type": "object",
          "oneOf": [
            { "required": ["relation"] },
            { "required": ["failure"] }
          ],
          "properties": {
            "relation": {
              "enum": ["equal", "contains", "contained-by", "overlaps", "disjoint"]
            },
            "failure": { "$ref": "#/$defs/failure" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "contentChunkNotification": {
      "type": "object",
      "required": ["jsonrpc", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "method": { "const": "monika.contentChunk" },
        "params": {
          "type": "object",
          "required": ["requestId", "offset", "base64"],
          "properties": {
            "requestId": { "$ref": "#/$defs/id" },
            "offset": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            "base64": { "type": "string", "pattern": "^[A-Za-z0-9+/]*={0,2}$" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "endContentNotification": {
      "type": "object",
      "required": ["jsonrpc", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "method": { "const": "monika.endContent" },
        "params": {
          "type": "object",
          "required": ["requestId", "byteLength"],
          "properties": {
            "requestId": { "$ref": "#/$defs/id" },
            "byteLength": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "errorResponse": {
      "type": "object",
      "required": ["jsonrpc", "id", "error"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": {
          "oneOf": [
            { "$ref": "#/$defs/id" },
            { "type": "null" }
          ]
        },
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": { "$ref": "#/$defs/safeInteger" },
            "message": { "type": "string", "minLength": 1 },
            "data": { "$ref": "#/$defs/protocolValue" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
