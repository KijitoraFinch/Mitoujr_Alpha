{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://monika.local/schemas/related-result.schema.json",
  "title": "RelatedResult",
  "type": "object",
  "required": [
    "schemaVersion",
    "status",
    "query",
    "matches",
    "diagnostics",
    "coverage",
    "truncated"
  ],
  "properties": {
    "schemaVersion": {
      "const": "4"
    },
    "status": {
      "enum": ["ok", "incomplete", "failed"]
    },
    "query": {
      "type": "object",
      "required": [
        "observation",
        "direction",
        "limit"
      ],
      "properties": {
        "observation": {
          "$ref": "command-result.schema.json#/$defs/path"
        },
        "direction": {
          "enum": [
            "incoming",
            "outgoing",
            "both"
          ]
        },
        "predicate": {
          "type": "string",
          "minLength": 1
        },
        "region": {
          "type": "string",
          "minLength": 1
        },
        "regionScope": {
          "enum": ["exact", "contained"]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "dependentRequired": {
        "region": ["regionScope"],
        "regionScope": ["region"]
      },
      "additionalProperties": false
    },
    "matches": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/match"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "command-result.schema.json#/$defs/diagnostic"
      }
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "truncated": {
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "ok" } }
      },
      "then": {
        "properties": {
          "diagnostics": {
            "not": {
              "contains": {
                "properties": {
                  "effectiveSeverity": { "const": "error" }
                },
                "required": ["effectiveSeverity"]
              }
            }
          },
          "coverage": {
            "properties": { "complete": { "const": true } }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "incomplete" } }
      },
      "then": {
        "properties": {
          "coverage": {
            "properties": { "complete": { "const": false } }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "failed" } }
      },
      "then": {
        "properties": {
          "matches": { "maxItems": 0 },
          "diagnostics": {
            "minItems": 1,
            "contains": {
              "properties": {
                "effectiveSeverity": { "const": "error" }
              },
              "required": ["effectiveSeverity"]
            }
          },
          "coverage": {
            "properties": {
              "scannedObservations": { "const": 0 },
              "interpretedObservations": { "const": 0 },
              "unsupportedObservations": { "const": 0 },
              "failedObservations": { "const": 0 },
              "complete": { "const": false }
            }
          },
          "truncated": { "const": false }
        }
      }
    }
  ],
  "$defs": {
    "match": {
      "type": "object",
      "required": [
        "direction",
        "kind",
        "predicate",
        "source",
        "target",
        "sourceResolution",
        "targetResolution"
      ],
      "properties": {
        "direction": {
          "enum": [
            "incoming",
            "outgoing",
            "internal"
          ]
        },
        "kind": {
          "enum": [
            "reference-occurrence",
            "semantic-relation"
          ]
        },
        "predicate": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "command-result.schema.json#/$defs/regionAddress"
        },
        "target": {
          "$ref": "command-result.schema.json#/$defs/regionAddress"
        },
        "sourceResolution": {
          "enum": [
            "resolved",
            "unresolved",
            "invalid-selector",
            "unreadable",
            "not-checked"
          ]
        },
        "targetResolution": {
          "enum": [
            "resolved",
            "unresolved",
            "invalid-selector",
            "unreadable",
            "not-checked"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "reference": {
          "$ref": "command-result.schema.json#/$defs/scopedId"
        },
        "annotation": {
          "$ref": "command-result.schema.json#/$defs/scopedId"
        },
        "range": {
          "$ref": "command-result.schema.json#/$defs/range"
        }
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": [
        "scannedObservations",
        "interpretedObservations",
        "unsupportedObservations",
        "failedObservations",
        "complete"
      ],
      "properties": {
        "scannedObservations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "interpretedObservations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unsupportedObservations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "failedObservations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "complete": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  }
}
