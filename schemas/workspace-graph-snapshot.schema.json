{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://monika.local/schemas/workspace-graph-snapshot.schema.json",
  "title": "WorkspaceGraphSnapshot",
  "description": "Immutable typed graph assembled from one stable workspace observation attempt.",
  "type": "object",
  "required": [
    "schemaVersion",
    "observations",
    "sidecarSnapshots",
    "regions",
    "annotationIndex",
    "referenceIndex",
    "referenceUses",
    "relations",
    "referenceEdges",
    "diagnostics",
    "coverage"
  ],
  "properties": {
    "schemaVersion": { "const": "2" },
    "observations": {
      "type": "array",
      "items": { "$ref": "observation.schema.json" }
    },
    "sidecarSnapshots": {
      "type": "array",
      "items": { "$ref": "sidecar-snapshot.schema.json" }
    },
    "regions": {
      "type": "array",
      "items": { "$ref": "region.schema.json" }
    },
    "annotationIndex": {
      "type": "array",
      "items": { "$ref": "#/$defs/annotationIndexEntry" }
    },
    "referenceIndex": {
      "type": "array",
      "items": { "$ref": "#/$defs/referenceIndexEntry" }
    },
    "referenceUses": {
      "type": "array",
      "items": { "$ref": "reference-use.schema.json" }
    },
    "relations": {
      "type": "array",
      "items": { "$ref": "#/$defs/relation" }
    },
    "referenceEdges": {
      "type": "array",
      "items": { "$ref": "#/$defs/referenceEdge" }
    },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "diagnostic.schema.json" }
    },
    "coverage": { "$ref": "coverage.schema.json" }
  },
  "additionalProperties": false,
  "$defs": {
    "annotationIndexEntry": {
      "oneOf": [
        {
          "type": "object",
          "required": ["id", "status", "value", "occurrences"],
          "properties": {
            "id": { "$ref": "command-result.schema.json#/$defs/originScopedId" },
            "status": { "const": "consistent" },
            "value": { "$ref": "annotation.schema.json" },
            "occurrences": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "annotation-occurrence.schema.json" }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["id", "status", "occurrences"],
          "properties": {
            "id": { "$ref": "command-result.schema.json#/$defs/originScopedId" },
            "status": { "const": "conflict" },
            "occurrences": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "annotation-occurrence.schema.json" }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "referenceIndexEntry": {
      "oneOf": [
        {
          "type": "object",
          "required": ["id", "status", "value", "occurrences"],
          "properties": {
            "id": { "$ref": "command-result.schema.json#/$defs/originScopedId" },
            "status": { "const": "consistent" },
            "value": { "$ref": "reference.schema.json" },
            "occurrences": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "reference-definition-occurrence.schema.json" }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["id", "status", "occurrences"],
          "properties": {
            "id": { "$ref": "command-result.schema.json#/$defs/originScopedId" },
            "status": { "const": "conflict" },
            "occurrences": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "reference-definition-occurrence.schema.json" }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "relationEndpoint": {
      "type": "object",
      "required": ["kind", "region"],
      "properties": {
        "kind": { "const": "region" },
        "region": { "$ref": "command-result.schema.json#/$defs/regionRef" }
      },
      "additionalProperties": false
    },
    "relation": {
      "type": "object",
      "required": ["id", "source", "predicate", "target", "evidence"],
      "properties": {
        "id": { "$ref": "command-result.schema.json#/$defs/originScopedId" },
        "source": { "$ref": "#/$defs/relationEndpoint" },
        "predicate": { "type": "string", "minLength": 1 },
        "target": { "$ref": "#/$defs/relationEndpoint" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "annotation-occurrence.schema.json" }
        }
      },
      "additionalProperties": false
    },
    "referenceEdgeTarget": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "address"],
          "properties": {
            "kind": { "const": "address" },
            "address": { "$ref": "command-result.schema.json#/$defs/regionAddress" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "reference"],
          "properties": {
            "kind": { "const": "unresolved-reference" },
            "reference": { "$ref": "command-result.schema.json#/$defs/originScopedId" }
          },
          "additionalProperties": false
        }
      ]
    },
    "referenceEdge": {
      "type": "object",
      "required": [
        "source",
        "target",
        "sourceResolution",
        "targetResolution",
        "use"
      ],
      "properties": {
        "source": { "$ref": "command-result.schema.json#/$defs/regionAddress" },
        "target": { "$ref": "#/$defs/referenceEdgeTarget" },
        "sourceResolution": { "$ref": "#/$defs/resolution" },
        "targetResolution": { "$ref": "#/$defs/resolution" },
        "use": { "$ref": "reference-use.schema.json" }
      },
      "additionalProperties": false
    },
    "resolution": {
      "enum": [
        "resolved",
        "unresolved",
        "invalid-selector",
        "unreadable",
        "not-checked"
      ]
    }
  }
}
